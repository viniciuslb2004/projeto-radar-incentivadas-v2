{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "webapp/static",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/consolidado", "destination": "/index.html" },
    { "source": "/tendencias", "destination": "/index.html" },
    { "source": "/busca", "destination": "/index.html" },
    { "source": "/editais", "destination": "/index.html" },
    { "source": "/linhas-incentivadas", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{webapp/static/**,data/raw/**,data/rfb_tmp/**,scripts/**,.github/**}"
    }
  }
}
